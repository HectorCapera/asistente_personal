{
  "name": "brujula-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "web": "vite --host 127.0.0.1",
    "desktop": "wait-on http://127.0.0.1:5173 && electron .",
